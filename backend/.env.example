# NovaPay Backend Environment Configuration
PORT=3001
HOST=0.0.0.0

# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Allowed Frontend Origins (CORS)
CORS_ORIGIN=https://novapay-tma.vercel.app,http://localhost:5173

# Exchange Rate (USDT to RUB)
USDT_RUB_RATE=93.00

# SBP Processing Spread (% fee for auto-conversion)
SBP_SPREAD_PERCENT=1.5
